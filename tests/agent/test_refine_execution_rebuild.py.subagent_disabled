def test_last_execution_plan_card_helper():
    """_last_execution_plan_card returns the latest matching card."""
    history = [
        _aave_supply_card_base(),
        {"card_type": "defi_opportunities", "payload": {"items": []}},
        _uniswap_v3_lp_card(),

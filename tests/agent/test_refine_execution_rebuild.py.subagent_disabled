def test_canonical_fixture_chain_and_amount_override():
    """Canonical user-spec fixture: prior=Aave V3 USDC supply on Base; new
    message='Same but on Optimism with 250 USDT' → returns
    build_yield_execution_plan with chain=optimism, asset=USDT, amount=250.
    """
    history = [_aave_supply_card_base()]
    result = _synthesize_refine_execution_args(
        "Same but on Optimism with 250 USDT", history
    )
    assert result is not None, "refine-execution synth must fire on chain+amount override"
    tool_name, args = result
    assert tool_name == "build_yield_execution_plan"
    assert args["chain"] == "optimism"
    assert args["protocol"] == "aave-v3"  # inherited from prior
    assert args["action"] == "supply"  # inherited
    assert args["asset_in"] == "USDT"
    assert args["amount_in"] == 250.0


def test_protocol_only_refine_lido():
    """'Lido only' switches protocol + remaps action to stake."""
    history = [_aave_supply_card_base()]
    result = _synthesize_refine_execution_args("Lido only", history)
    assert result is not None
    _, args = result
    assert args["protocol"] == "lido"
    assert args["action"] == "stake"
    # Chain inherited from prior (base), but lido is ethereum-only —
    # the registry-gate downstream will surface UNSUPPORTED_CHAIN; the
    # synth itself doesn't fight the user's prior chain.
    assert args["chain"] == "base"


